{
  "name": "@tasksquatch/presubmit",
  "version": "0.1.3",
  "description": "Local Presubmit CLI to run repo checks and publish a GitHub Check Run",
  "keywords": [
    "presubmit",
    "github",
    "checks",
    "cli"
  ],
  "homepage": "https://github.com/tasksquatch/presubmit#readme",
  "bugs": {
    "url": "https://github.com/tasksquatch/presubmit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tasksquatch/presubmit.git"
  },
  "license": "MIT",
  "author": "Tasksquatch",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "presubmit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/cli.ts",
    "presubmit": "tsx src/cli.ts"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.0.0",
    "@octokit/oauth-methods": "^6.0.5",
    "@octokit/request": "^10.0.16",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
